# Dify の API キー（チャットボットアプリの「APIアクセス」から発行）
# 取得先: Dify アプリ画面 → 左メニュー「APIアクセス」→「APIキー」
DIFY_API_KEY=your_dify_api_key_here

# Dify の API ベースURL
# Dify Cloud（cloud.dify.ai）を使う場合は変更不要
# セルフホストの場合は自分の環境のURL（例: https://your-dify-host/v1）に変更
DIFY_API_BASE_URL=https://api.dify.ai/v1

# LINE チャンネルアクセストークン（長期）
# 取得先: https://developers.line.biz → チャンネル設定 → Messaging API → チャンネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE チャンネルシークレット（webhookの検証に使用）
# 取得先: https://developers.line.biz → チャンネル設定 → チャンネル基本設定 → Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here
